# Fémini Stock — Apache rules (cPanel)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (AutoSSL on cPanel). Remove while testing on plain http://localhost.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Every /api/* request goes to the API front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/ api/index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Compress text responses (the app page is ~1 MB of HTML; JSON and JS shrink 5-10x).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# Never serve dotfiles, SQL, logs or config from the web root.
<FilesMatch "(^\.|\.(sql|log|md|json)$|config\.php$)">
  Require all denied
</FilesMatch>
